# Variables adicionales para el overlay Traefik.
# Copia estas líneas a tu `.env` (junto con `.env.example`) antes del deploy.

# Dominio público (debe coincidir con WEB_ORIGIN y NEXT_PUBLIC_SITE_URL).
PUBLIC_HOST=secured.example.com
WEB_ORIGIN=https://secured.example.com
NEXT_PUBLIC_SITE_URL=https://secured.example.com

# Certificado TLS en Traefik (nombre del certificatesresolvers.* configurado).
TRAEFIK_CERT_RESOLVER=letsencrypt

# Publicar el puerto solo en localhost; Traefik enruta el tráfico externo.
HOST_BIND=127.0.0.1
HOST_PORT=3001
APP_PORT=3001
