# ——— General ———
NODE_ENV=production
LOG_LEVEL=info
# Origen del sitio (CSP, servidor). Debe ser la URL base en el navegador (puerto incluido).
WEB_ORIGIN=http://localhost:3001

# ——— Docker Compose (imagen, contenedor, puertos) ———
# Mismo fichero: `docker compose` carga este `.env` (build + runtime vía `env_file`).
APP_PORT=3001
HOST_PORT=3001
# Enlazar solo localhost detrás de Traefik (ver `.env.traefik.example`).
# HOST_BIND=127.0.0.1
# Nombre de imagen local y contenedor (opcionales; tienen valores por defecto en compose)
# COMPOSE_IMAGE_NAME=secured-note:local
# COMPOSE_CONTAINER_NAME=secured-note-app

# Ruta a la base SQLite. En contenedor, volumen `app-data` → `/data/`.
SQLITE_PATH=/data/secured-note.db

# ——— HSTS (cabecera; solo aplica con NODE_ENV=production en runtime) ———
HSTS_MAX_AGE_SECONDS=31536000
HSTS_PRELOAD=false

# ——— Público (entran en el bundle en `pnpm build` / `docker build`) ———
NEXT_PUBLIC_API_BASE=
# URL pública HTTPS del sitio (sin barra final). CSP report-to, upgrade-insecure-requests, Open Graph.
NEXT_PUBLIC_SITE_URL=
# Origen HTTPS solo para reportes CSP, si no usas NEXT_PUBLIC_SITE_URL.
# CSP_REPORT_BASE=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/octocat/Hello-World

# `PUBLIC_GITHUB_REPO_URL` en el servidor se rellena desde `NEXT_PUBLIC_GITHUB_REPO_URL` (no duplicar en .env)

# ——— Marca (opcionales) ———
# NEXT_PUBLIC_BRAND_APP_NAME=Mi Organización
# NEXT_PUBLIC_BRAND_PRIMARY=#004e70
# NEXT_PUBLIC_BRAND_ACCENT=#009ade
# NEXT_PUBLIC_BRAND_BACKGROUND=#001a28

# ——— Notas / dev local sin Docker ———
# Instance setup en project_config (asistente único). Ver README.
# En local, si no pones nada, suele usarse: SQLITE_PATH=web/data/secured-note.db (relativa al cwd del proceso).
